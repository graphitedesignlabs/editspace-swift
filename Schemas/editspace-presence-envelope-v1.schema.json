{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editspace.dev/schema/presence-envelope-v1.json",
  "title": "EditSpace presence envelope v1",
  "type": "object",
  "required": ["kind", "v", "doc", "presence"],
  "properties": {
    "kind": { "const": "editspace.presence" },
    "v": { "const": 1 },
    "doc": { "type": "string", "minLength": 1 },
    "presence": {
      "type": "object",
      "required": ["identity", "sessionID", "state", "sequence", "selectedEntities", "focus", "updatedAt", "timeToLiveSeconds"],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["peerID", "actorID", "attributes"],
          "properties": {
            "peerID": { "type": "string", "minLength": 1 },
            "actorID": { "type": "string", "minLength": 1 },
            "displayName": { "type": ["string", "null"] },
            "color": { "type": ["string", "null"] },
            "avatarURL": { "type": ["string", "null" ] },
            "attributes": { "type": "object" }
          },
          "additionalProperties": true
        },
        "sessionID": { "type": "string", "minLength": 1 },
        "state": { "enum": ["active", "idle", "away", "offline"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "selectedEntities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": { "kind": { "type": "string" }, "id": { "type": "string" } },
            "additionalProperties": true
          }
        },
        "focus": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "timeToLiveSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
