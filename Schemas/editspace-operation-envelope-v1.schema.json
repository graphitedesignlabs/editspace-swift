{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editspace.dev/schema/operation-envelope-v1.json",
  "title": "EditSpace operation envelope v1",
  "type": "object",
  "required": ["kind", "v", "doc", "ops"],
  "properties": {
    "kind": { "const": "editspace.operations" },
    "v": { "const": 1 },
    "doc": { "type": "string", "minLength": 1 },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["doc", "op", "actor", "seq", "action", "entity"],
      "properties": {
        "v": { "type": "integer", "minimum": 1, "default": 1 },
        "doc": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "deps": { "type": "array", "items": { "type": "string" }, "default": [] },
        "action": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "source": { "type": "string" },
        "fields": { "type": "object", "default": {} },
        "args": { "type": "object", "default": {} },
        "features": { "type": "array", "items": { "type": "string" }, "default": [] },
        "producer": {
          "type": "object",
          "required": ["app", "library"],
          "properties": {
            "app": { "type": "string" },
            "appVersion": { "type": "string" },
            "library": { "type": "string" },
            "libraryVersion": { "type": "string" }
          },
          "additionalProperties": true
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
